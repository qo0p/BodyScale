<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:paddingTop="4dp"
            android:text="@string/back"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_title"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/profile_subtitle"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView style="@style/Label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/profile_height" />
        <EditText
            android:id="@+id/pHeight"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="number" />

        <TextView style="@style/Label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/profile_age" />
        <EditText
            android:id="@+id/pAge"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="number" />

        <TextView style="@style/Label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/profile_target" />
        <EditText
            android:id="@+id/pTarget"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="numberDecimal" />

        <RadioGroup
            android:id="@+id/pSexGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/pMale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/accent"
                android:text="@string/male"
                android:textColor="@color/text" />

            <RadioButton
                android:id="@+id/pFemale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/accent"
                android:text="@string/female"
                android:textColor="@color/text" />
        </RadioGroup>

        <Button
            android:id="@+id/btnSave"
            style="@style/ButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/profile_save" />

        <Button
            android:id="@+id/btnForget"
            style="@style/ButtonGhost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/profile_forget" />
    </LinearLayout>
</ScrollView>
