<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:paddingTop="4dp"
            android:text="@string/back"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calc_title"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/calc_subtitle"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView style="@style/Label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/calc_weight" />
        <EditText
            android:id="@+id/inWeight"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="numberDecimal"
            android:hint="70.0" />

        <TextView style="@style/Label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/calc_height" />
        <EditText
            android:id="@+id/inHeight"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="number"
            android:hint="175" />

        <TextView style="@style/Label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/calc_age" />
        <EditText
            android:id="@+id/inAge"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="number"
            android:hint="30" />

        <TextView style="@style/Label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/calc_impedance" />
        <EditText
            android:id="@+id/inImpedance"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="numberDecimal"
            android:hint="e.g. 520" />

        <RadioGroup
            android:id="@+id/sexGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/sexMale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/accent"
                android:text="@string/male"
                android:textColor="@color/text" />

            <RadioButton
                android:id="@+id/sexFemale"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/accent"
                android:text="@string/female"
                android:textColor="@color/text" />
        </RadioGroup>

        <Button
            android:id="@+id/btnCompute"
            style="@style/ButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/calc_button" />

        <LinearLayout
            android:id="@+id/metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
